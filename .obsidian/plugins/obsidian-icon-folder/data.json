{
  "settings": {
    "migrated": 6,
    "iconPacksPath": ".obsidian/icons",
    "fontSize": 16,
    "emojiStyle": "native",
    "iconColor": null,
    "recentlyUsedIcons": [
      "CuCodeigniterPlain",
      "CuTypescriptPlain",
      "CuTypescript",
      "CuFolderTasks",
      "CuRobots"
